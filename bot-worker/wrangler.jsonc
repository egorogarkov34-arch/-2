{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aquora-water-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "vars": {
    "AQUA_APP_URL": "https://aquora-water.onrender.com"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "PROFILES",
      "id": "bb9b7b7ea03b44e38d76df240b0e385f"
    }
  ]
}
