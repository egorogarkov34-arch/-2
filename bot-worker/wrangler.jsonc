{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aquora-water-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "AQUORA_USERS",
      "id": "8186cbf87fac41a5bcdf953d249d660d"
    }
  ],
  "vars": {
    "AQUA_APP_URL": "https://aquora-water.onrender.com"
  }
}
